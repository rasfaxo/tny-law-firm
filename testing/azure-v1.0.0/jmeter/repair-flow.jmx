                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">Kronologi pengajuan perkara untuk verifikasi staf legal secara otomatis via JMeter.</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
