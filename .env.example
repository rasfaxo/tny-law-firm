APP_NAME="TNY Law Firm"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Identitas bootstrap Admin. Semuanya wajib di production.
ADMIN_NAME=
ADMIN_EMAIL=
# Password default akun admin bawaan (AdminSeeder).
# WAJIB diisi saat APP_ENV=production, seeder akan gagal bila kosong.
ADMIN_DEFAULT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTPS staging must explicitly keep all session-cookie protections enabled.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
DOCUMENT_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_AFTER_COMMIT=true
DB_QUEUE_RETRY_AFTER=120
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@tnypartners.com"
MAIL_FROM_NAME="TNY & PARTNERS"
MAIL_REPLY_TO_ADDRESS="tny.partnerhukum@gmail.com"
MAIL_REPLY_TO_NAME="TNY & PARTNERS"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_PREFIX=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_THROW=true

FIRM_NAME="TNY & PARTNERS"
FIRM_TAGLINE="Advocates & Legal Consultants"
FIRM_DESCRIPTION="Kantor Advokat & Konsultan Hukum • Pelayanan Hukum Profesional & Berintegritas"
FIRM_ADDRESS="Jl. H Raya No. 11, RT 008/RW 010, Kel. Gandaria Utara, Kec. Kebayoran Baru, Jakarta Selatan, 12240"
FIRM_PHONE="+62 858-1055-4047"
FIRM_EMAIL="tny.partnerhukum@gmail.com"
FIRM_SECONDARY_EMAIL="tny.partnershukum@gmail.com"
FIRM_WEBSITE="https://tnypartners.com"
FIRM_CITY="Jakarta Selatan"

# Daftar host/IP proxy dipisahkan koma. Jangan gunakan wildcard pada shared hosting.
TRUSTED_HOSTS=localhost
# Gunakan nilai literal "none" bila hosting terhubung langsung tanpa reverse proxy.
TRUSTED_PROXIES=none

# Tetap false sampai naskah dan periode retensi disahkan pihak firma.
PRIVACY_POLICY_READY=false
PRIVACY_POLICY_VERSION=
PRIVACY_POLICY_EFFECTIVE_DATE=

VITE_APP_NAME="${APP_NAME}"

# Enable only while correlating a bounded staging performance run.
PERFORMANCE_TELEMETRY=false
PERFORMANCE_SLOW_QUERY_MS=250

# One-time helper for the isolated Azure v1.0.0 retest only.
# Leave disabled everywhere except the temporary fixture deployment.
RETEST_FIXTURES_ENABLED=false
RETEST_FIXTURE_CONFIRMATION=
RETEST_FIXTURE_PASSWORD=

# Strict CSP aktif secara default. Report-only hanya untuk observasi terkontrol.
SECURITY_CSP_REPORT_ONLY=false
SECURITY_HSTS_MAX_AGE=31536000
